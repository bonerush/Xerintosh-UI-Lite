        <!-- key insight note -->
        <mxCell id="note-key" value="关键: file_to_dev()&#xa;f→inode→private_data → kern_device_t*&#xa;&#xa;共享单例: g_device_bridge_fops&#xa;所有设备共用同一份 bridge fops" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="80" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="note-register" value="设备注册流程:&#xa;kern_device_register(dev)&#xa;→ 前插到 g_device_list&#xa;kern_devfs_register_device(dev)&#xa;→ 创建 /dev/xxx inode&#xa;→ i_fops = bridge fops&#xa;→ private_data = dev" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;fontStyle=2;" vertex="1" parent="1">
