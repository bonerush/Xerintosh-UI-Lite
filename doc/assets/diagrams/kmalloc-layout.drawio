<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Kmalloc Layout">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="内核分配器 kmalloc: 元数据头 + 自动资源追踪" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="15" width="500" height="35" as="geometry" />

        <!-- Memory layout -->
        <mxCell id="layout-title" value="内存布局 (kern_kmalloc(128))" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="250" height="25" as="geometry" />

        <!-- The memory block -->
        <mxCell id="block" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="320" height="140" as="geometry" />
        </mxCell>

        <!-- Header section -->
        <mxCell id="header-part" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="header-label" value="kmalloc_header_t (元数据头)&#xa;├─ size: 128&#xa;└─ owner: → ui_task TCB" style="text;html=1;fontSize=10;fontColor=#333333;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="45" y="102" width="300" height="46" as="geometry" />
        </mxCell>

        <!-- User data section -->
        <mxCell id="user-part" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="user-label" value="用户数据 (128 字节)&#xa;ptr 指向这里 → 返回给调用者" style="text;html=1;fontSize=10;fontColor=#333333;align=center;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="45" y="170" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- malloc return pointer -->
        <mxCell id="malloc-ptr" value="malloc() 返回" style="text;html=1;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="245" width="80" height="16" as="geometry" />
        </mxCell>
        <mxCell id="user-ptr" value="user_ptr 返回&#xa;(偏移 sizeof(header))" style="text;html=1;fontSize=10;fontColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="170" width="120" height="30" as="geometry" />
        </mxCell>

        <!-- get_header macro -->
        <mxCell id="get-header" value="get_header(ptr):&#xa;return (header*)(ptr - sizeof(header))&#xa;逆向计算元数据头位置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- Flow on the right -->
        <mxCell id="flow-title" value="完整分配 → 回收链路" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="450" y="70" width="200" height="25" as="geometry" />

        <mxCell id="flow-step1" value="① kern_kmalloc(128)&#xa;├→ malloc(header + 128)&#xa;├→ header.size = 128&#xa;├→ header.owner = current_task&#xa;└→ track(res, MEMORY, kmem_release)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="280" height="75" as="geometry" />
        </mxCell>

        <mxCell id="flow-arrow1" value="↓" style="text;html=1;fontSize=14;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="580" y="180" width="20" height="20" as="geometry" />
        </mxCell>

        <mxCell id="flow-step2" value="② kern_kfree(ptr)&#xa;├→ get_header(ptr) → header&#xa;├→ untrack(header.owner, ptr)&#xa;└→ free(header)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="200" width="280" height="65" as="geometry" />
        </mxCell>

        <mxCell id="flow-arrow2" value="↓" style="text;html=1;fontSize=14;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="580" y="270" width="20" height="20" as="geometry" />
        </mxCell>

        <mxCell id="flow-step3" value="③ 任务退出 (kern_exit)&#xa;└→ resource_release_all(task)&#xa;    └→ kmem_release(ptr)&#xa;        └→ get_header + free" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="290" width="280" height="75" as="geometry" />
        </mxCell>

        <!-- krealloc note -->
        <mxCell id="krealloc-note" value="krealloc 的特殊处理:&#xa;1. untrack 旧指针&#xa;2. realloc(header, +new_size)&#xa;3. if 失败: re-track 旧指针 (原子回滚)&#xa;4. if 成功: track 新指针到新 owner (可不同)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="320" height="75" as="geometry" />
        </mxCell>

        <!-- kcalloc note -->
        <mxCell id="kcalloc-note" value="kcalloc(nmemb, size) 快捷方式:&#xa;1. 溢出检查 (nmemb * size)&#xa;2. kern_kmalloc(total)&#xa;3. memset(ptr, 0, total)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="395" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- Safety features -->
        <mxCell id="safety-title" value="安全特性" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="450" y="390" width="80" height="25" as="geometry" />
        </mxCell>
        <mxCell id="safety-1" value="✓ 溢出检查: total &lt; size → NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="450" y="415" width="280" height="25" as="geometry" />
        </mxCell>
        <mxCell id="safety-2" value="✓ kfree(NULL) / kmalloc(0) 安全" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="450" y="445" width="280" height="25" as="geometry" />
        </mxCell>
        <mxCell id="safety-3" value="✓ 分配自动追踪 → 退出自动释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="450" y="475" width="280" height="25" as="geometry" />
        </mxCell>
        <mxCell id="safety-4" value="✓ krealloc 失败 → 旧内存不丢失" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="450" y="505" width="280" height="25" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
